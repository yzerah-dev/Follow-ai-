# ---------------------------------------------------------------------------
# Follow.AI — variables d'environnement (copier en .env.local)
# ---------------------------------------------------------------------------

# Connexion PostgreSQL. En local : Postgres 16. En production : chaîne de
# connexion directe Supabase (rôle postgres) — la RLS est appliquée via
# "set local role authenticated" + claims JWT dans chaque transaction.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/follow_ai

# Authentification : "local" (sessions signées, utilisateurs dans auth.users)
# "supabase" est prévu (voir docs/DEPLOYMENT.md) — non activé dans cette version.
AUTH_MODE=local
# Secret de signature des sessions (min. 32 caractères). Générer : openssl rand -base64 48
SESSION_SECRET=change-me-in-local-dev-with-a-long-random-secret-string

# Clé de chiffrement des secrets de connexion (AES-256-GCM, 32 octets en base64)
# Générer : openssl rand -base64 32
APP_ENCRYPTION_KEY=

# IA : "mock" (déterministe, aucun appel externe, signalé dans l'UI) ou "anthropic"
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5

# Génération d'images : "disabled" tant qu'aucun fournisseur n'est validé
IMAGE_PROVIDER=disabled

# Stockage des fichiers : "local" (./storage, accès contrôlé côté serveur)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage

# Secret des endpoints planifiés (Vercel Cron) et des webhooks entrants
CRON_SECRET=
WEBHOOK_SIGNING_SECRET=

# Affiche les outils de démonstration (simulation de réponse client)
DEMO_TOOLS=true

# WhatsApp Business Platform (Meta) — webhook entrant
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
